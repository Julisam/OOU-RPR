import { Link, useLocation } from "react-router-dom";

function ResearchSidebar() {
  const location = useLocation();
  const isActive = (path) => location.pathname === path;

  return (
    <div className="w-64 bg-white shadow-sm rounded-lg p-6">
      <h3 className="text-lg font-semibold text-gray-800 mb-4">Research Categories</h3>
      <nav className="space-y-2">
        <Link
          to="/publications"
          className={`block px-4 py-2 rounded transition ${
            isActive("/publications")
              ? "bg-blue-600 text-white"
              : "text-gray-700 hover:bg-gray-100"
          }`}
        >
          Publications
        </Link>
        <Link
          to="/conferences"
          className={`block px-4 py-2 rounded transition ${
            isActive("/conferences")
              ? "bg-blue-600 text-white"
              : "text-gray-700 hover:bg-gray-100"
          }`}
        >
          Conferences
        </Link>
        <Link
          to="/grants"
          className={`block px-4 py-2 rounded transition ${
            isActive("/grants")
              ? "bg-blue-600 text-white"
              : "text-gray-700 hover:bg-gray-100"
          }`}
        >
          Grants
        </Link>
        <Link
          to="/collaborations"
          className={`block px-4 py-2 rounded transition ${
            isActive("/collaborations")
              ? "bg-blue-600 text-white"
              : "text-gray-700 hover:bg-gray-100"
          }`}
        >
          Collaborations
        </Link>
        <Link
          to="/patents"
          className={`block px-4 py-2 rounded transition ${
            isActive("/patents")
              ? "bg-blue-600 text-white"
              : "text-gray-700 hover:bg-gray-100"
          }`}
        >
          Patents
        </Link>
      </nav>
    </div>
  );
}

export default ResearchSidebar;